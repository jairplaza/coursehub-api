  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": ""
        }
      },
      "response": []
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();\r\nif (data && data.accessToken) {\r\n  pm.environment.set('token', data.accessToken);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{testEmail}}\",\r\n  \"password\": \"Password123!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Get Courses (Protected)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "courses"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Create Course (Protected)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "courses"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Auth Error (401/403)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "courses"
          ]
        }
      },
      "response": []
    }
  ]
